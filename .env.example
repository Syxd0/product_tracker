# ==============================================================================
# Product Tracker - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your actual values.
# NEVER commit the .env file or reveal secrets in git.

# ----------------- Backend Configuration (FastAPI) -----------------
# PostgreSQL Database URL (e.g. Neon, Render, Supabase, or local PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg2://username:password@hostname:5432/databasename?sslmode=require

# JWT Authentication Secret Key (Generate a random 32+ char string, e.g. using `openssl rand -hex 32`)
SECRET_KEY=your_secure_random_jwt_secret_key_here

# JWT Algorithm (default: HS256)
ALGORITHM=HS256

# Access Token Expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment Mode: 'development' or 'production'
# In production, cookies are marked Secure and SameSite=None
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated list of allowed frontend origins)
# Example: http://localhost:3000,http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-product-tracker.vercel.app

# Optional regex for dynamic preview deployments (e.g. all *.vercel.app branches)
ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# ----------------- Frontend Configuration (React / Vite) -----------------
# API URL for React (Create React App standard)
REACT_APP_API_URL=http://localhost:8000

# API URL for Vite standard
VITE_API_BASE_URL=http://localhost:8000
